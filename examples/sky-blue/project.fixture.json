{
  "fixtureVersion": 1,
  "project": {
    "name": "为什么天空是蓝色？",
    "document": {
      "schemaVersion": 1,
      "settings": {
        "width": 1080,
        "height": 1920,
        "fps": 30
      },
      "theme": {
        "background": "#0B1020",
        "accent": "#67D8FF",
        "fontId": "bundled-cjk"
      },
      "scenes": [
        {
          "id": "scene_intro",
          "templateId": "title",
          "title": "为什么天空是蓝色？",
          "body": "从阳光和空气说起",
          "narrationText": "抬头看天空，你有没有想过，它为什么常常是蓝色的？我们从阳光说起。",
          "durationFrames": 180,
          "imageAssetId": "asset_sunlight",
          "voiceover": null
        },
        {
          "id": "scene_sunlight",
          "templateId": "knowledge",
          "title": "阳光包含不同颜色",
          "body": "看似白色的阳光，包含多种可见光。",
          "narrationText": "太阳光看起来接近白色，其中却包含不同颜色的光。蓝光和红光，波长并不一样；蓝光的波长更短。",
          "durationFrames": 360,
          "imageAssetId": "asset_sunlight",
          "voiceover": null
        },
        {
          "id": "scene_scattering",
          "templateId": "knowledge",
          "title": "空气会让光发生散射",
          "body": "空气分子更容易散射较短波长的蓝光。",
          "narrationText": "阳光进入大气后，会被空气分子散射到不同方向。相比红光，蓝光更容易被散射。于是，我们望向远离太阳的天空时，接收到许多散射来的蓝光。",
          "durationFrames": 540,
          "imageAssetId": "asset_scattering",
          "voiceover": null
        },
        {
          "id": "scene_sunset",
          "templateId": "knowledge",
          "title": "日落为什么偏红？",
          "body": "阳光穿过更长的大气路径，直射光的颜色发生变化。",
          "narrationText": "日落时，太阳光穿过大气的路径更长，更多蓝光被散射离开直射方向。抵达眼睛的直射光，就更偏红色和橙色。",
          "durationFrames": 480,
          "imageAssetId": "asset_sunset",
          "voiceover": null
        },
        {
          "id": "scene_summary",
          "templateId": "summary",
          "title": "记住这条线索",
          "body": "阳光的颜色组成 + 空气散射 = 常见天空颜色的线索",
          "narrationText": "理解天空的颜色，要同时看阳光包含什么颜色，以及大气怎样散射这些光。",
          "durationFrames": 240,
          "imageAssetId": null,
          "voiceover": null
        }
      ],
      "music": {
        "assetId": "asset_test_music",
        "sourceStartSample": 0,
